# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
# Project URL and keys: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for captured frames.
SUPABASE_FRAMES_BUCKET=frames

# --- ElevenLabs / ElevenAgents ---
ELEVENLABS_API_KEY=
# Interviewer + tutor agent ids (create in the ElevenAgents dashboard).
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=
# Optional provisioning overrides.
ELEVENLABS_LLM=claude-sonnet-4-6
ELEVENLABS_INTERVIEWER_VOICE_ID=
ELEVENLABS_TUTOR_VOICE_ID=

# --- Vision model ---
# One fast vision model only (Gemini Flash or Claude Haiku/Sonnet class).
VISION_PROVIDER=google
GOOGLE_VISION_API_KEY=
# Pinned names get retired for new keys; leave blank to use gemini-flash-latest.
VISION_MODEL=gemini-flash-latest
# Retried once on 429/500/503 (default gemini-flash-lite-latest).
VISION_FALLBACK_MODEL=
# Raw frames are sent only to this server-side redaction boundary. The returned
# redacted JPEG is then sent to the configured vision provider.
FRAME_REDACTION_URL=
# Use presidio for the included local image-redactor binary-response adapter;
# omit for the documented JSON redactor contract.
FRAME_REDACTION_MODE=presidio
FRAME_REDACTION_TOKEN=
FRAME_REDACTION_TIMEOUT_MS=10000
VISION_TIMEOUT_MS=20000
# Keep false until both the redactor and vision provider are configured.
NEXT_PUBLIC_ENABLE_VISION=false

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# report keeps the demo compatible while surfacing missing security. enforce
# requires a matching signed HttpOnly capability on session-scoped API routes.
APP_SECURITY_MODE=report
# Generate at least 32 random bytes; this is server-only.
APP_SESSION_SECRET=
ALLOW_ORIGINLESS_API=false
# The included limiter protects one process. Production needs a shared limiter
# supplied by the hosting platform or a managed Redis-compatible service.
RATE_LIMIT_BACKEND=memory
# Enable only after Supabase Auth and migration 0004_session_security.sql.
NEXT_PUBLIC_ENABLE_REALTIME=false

# Optional: point this boundary at a separately hosted Microsoft Presidio
# Analyzer service. The local redaction fallback remains active when unset.
PRESIDIO_ANALYZER_URL=
PRESIDIO_TIMEOUT_MS=5000
