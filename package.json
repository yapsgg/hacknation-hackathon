{
  "name": "agent",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/apprentice-state.test.ts tests/phase23.test.ts tests/phase45.test.ts tests/security-boundaries.test.ts tests/system-readiness.test.ts",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "todo": "node scripts/generate-todo.mjs",
    "orchestrate": "node scripts/orchestrate.mjs",
    "provision:agents": "node --env-file=.env.local scripts/provision-agents.mjs",
    "acceptance:local": "node --env-file=.env.local scripts/acceptance.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@elevenlabs/react": "^1.16.0",
    "@shadcn/react": "^0.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.8.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
